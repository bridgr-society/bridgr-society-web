# Bridgr Society — environment variables (NAMES AND PLACEHOLDERS ONLY).
# Copy to .env.local for local work. Never commit real values. Set real values in
# Vercel → Project → Settings → Environment Variables, per environment.

# Public URL of this deployment (used for metadata, sitemap). Safe to expose.
NEXT_PUBLIC_SITE_URL=https://society.example.invalid

# --- Preview / staging only -----------------------------------------------
# Enables the TEST-DATA mode (test sign-in, test applications in signed cookies,
# enquiries not delivered). Ignored in production — see lib/env.ts.
SOCIETY_PREVIEW_DEMO=false
# 32+ random characters. Required for preview sign-in. Generate: openssl rand -base64 32
SOCIETY_SESSION_SECRET=replace-with-32-plus-random-characters

# --- Enquiry delivery (choose ONE; leave unset to show "not connected") ----
# Option A: POST JSON to your CRM / automation endpoint
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
# Option B: email via Resend (https://resend.com) — needs a verified sending domain
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# --- Shared Bridgr identity (NOT IMPLEMENTED — blocked on production repo) --
# Setting these disables preview sign-in and shows "sign-in pending".
BRIDGR_AUTH_ISSUER=
BRIDGR_AUTH_CLIENT_ID=
BRIDGR_AUTH_CLIENT_SECRET=

# --- Academy applicant offer ---------------------------------------------
# Second switch for the offer; content/offer.ts must ALSO be changed. Keep false.
ACADEMY_OFFER_APPROVED=false
